generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Problem {
  id              String           @id
  slug            String           @unique
  title           String
  difficulty      String
  level           Int              @unique
  topic           String
  pattern         String
  judgeKind       String
  xpReward        Int
  coinReward      Int
  prizeMoneyInr   Int?
  description     String
  starterCode     Json
  testCases       Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  solutionReplays SolutionReplay[]
  submissions     Submission[]
}

model User {
  id                 String              @id
  clerkId            String              @unique
  username           String              @unique
  fullName           String
  email              String              @unique
  avatarUrl          String
  avatarMode         String              @default("image")
  avatarTheme        String              @default("violet")
  college            String              @default("Connect authentication to set college")
  authProvider       String
  bio                String              @default("")
  graduationYear     String              @default("")
  country            String              @default("")
  preferredLanguage  String              @default("C++")
  publicProfile      Boolean             @default(true)
  showCollege        Boolean             @default(true)
  showStats          Boolean             @default(true)
  website            String              @default("")
  github             String              @default("")
  linkedin           String              @default("")
  twitter            String              @default("")
  xp                 Int                 @default(0)
  coins              Int                 @default(0)
  moneyEarnedInr     Int                 @default(0)
  reputation         Int                 @default(0)
  devRank            Int                 @default(0)
  currentStreak      Int                 @default(0)
  longestStreak      Int                 @default(0)
  streakShields      Int                 @default(0)
  isPro              Boolean             @default(false)
  solvedProblemIds   Json
  lastSolvedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  rewardTransactions RewardTransaction[]
  solutionReplays    SolutionReplay[]
  submissions        Submission[]
  withdrawals        Withdrawal[]
  withdrawalRequests WithdrawalRequest[]

  @@index([xp, currentStreak, lastSolvedAt])
  @@index([updatedAt])
  @@index([username, updatedAt])
}

model RewardTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      String
  source    String
  amount    Int
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Withdrawal {
  id         String   @id @default(cuid())
  userId     String
  coins      Int
  cashAmount Float
  upiId      String
  status     String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  upiId     String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model LiveReward {
  id                 String    @id @default(cuid())
  problemId          String    @unique
  rewardMoney        Float
  startsAt           DateTime
  endsAt             DateTime
  isActive           Boolean   @default(true)
  winnerUserId       String?
  winnerSubmissionId String?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([problemId, isActive, startsAt, endsAt])
}

model ProblemBoardConfig {
  id                  String   @id @default("singleton")
  showUpcomingRewards Boolean  @default(true)
  upcomingRewardItems Json
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Submission {
  id          String   @id @default(cuid())
  problemId   String
  userId      String?
  language    String
  code        String
  status      String
  passedCount Int
  totalCount  Int
  runtimeMs   Int
  output      Json
  createdAt   DateTime @default(now())
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([problemId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

model SolutionReplay {
  id               String   @id @default(cuid())
  userId           String
  problemId        String
  submissionId     String   @unique
  language         String
  replayData       Json
  solveTimeSeconds Int
  pasteCount       Int      @default(0)
  pastedCharacters Int      @default(0)
  runCount         Int      @default(0)
  tabSwitchCount   Int      @default(0)
  createdAt        DateTime @default(now())
  trustScore       Int      @default(100)
  problem          Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([problemId, createdAt])
  @@index([solveTimeSeconds, createdAt])
}
