// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Problem {
  id             String       @id
  slug           String       @unique
  title          String
  difficulty     String
  level          Int          @unique
  topic          String
  pattern        String
  judgeKind      String
  xpReward       Int
  coinReward     Int
  prizeMoneyInr  Int?
  description    String
  starterCode    Json
  testCases      Json
  submissions    Submission[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model User {
  id               String        @id
  clerkId          String        @unique
  username         String        @unique
  fullName         String
  email            String        @unique
  avatarUrl        String
  college          String        @default("Connect authentication to set college")
  authProvider     String
  xp               Int           @default(0)
  coins            Int           @default(0)
  moneyEarnedInr   Int           @default(0)
  reputation       Int           @default(0)
  devRank          Int           @default(0)
  currentStreak    Int           @default(0)
  longestStreak    Int           @default(0)
  streakShields    Int           @default(0)
  isPro            Boolean       @default(false)
  solvedProblemIds  Json
  lastSolvedAt      DateTime?
  submissions      Submission[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([xp, currentStreak, lastSolvedAt])
  @@index([updatedAt])
}

model Submission {
  id             String   @id @default(cuid())
  problemId      String
  userId         String?
  language       String
  code           String
  status         String
  passedCount    Int
  totalCount     Int
  runtimeMs      Int
  output         Json
  createdAt      DateTime @default(now())
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([problemId])
  @@index([userId])
  @@index([createdAt])
}
